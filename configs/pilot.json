{
  "schema_version": 1,
  "data_limit": 240,
  "device": "cpu",
  "warmup_seed": 42,
  "warmup_epochs": 2,
  "strategy_seeds": [17, 29, 43],
  "strategies": ["random", "uncertainty", "diverse"],
  "budget_images": 12,
  "candidate_epochs": 2,
  "learning_rate": 0.005,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "trainable": "roi_heads.box_predictor only; all other parameters and backbone buffers frozen",
  "score_threshold": 0.5,
  "iou_threshold": 0.5,
  "gate": {
    "max_overall_AP_drop": 0.01,
    "max_night_recall_drop": 0.05,
    "minimum_night_images": 20,
    "minimum_night_objects": 100,
    "note": "Illustrative offline gate; insufficient night support yields INSUFFICIENT_EVIDENCE, never PASS"
  }
}

